# Groq API key — create one for free at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional: when MOCK_MODE=true, /api/chat returns a scripted 5-turn
# conversation instead of calling Groq. Useful for iterating on the UI
# without consuming Groq rate limits. Leave unset (or false) in production.
# MOCK_MODE=false
